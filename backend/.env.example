PORT=4000
JWT_SECRET=cms-dev-secret-change-me
JWT_EXPIRES_IN=7d
# Local default: PGlite wire server from repo root (`npm run db:local`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres
TYPEORM_SYNC=true
TYPEORM_LOGGING=false
CORS_ORIGIN=http://localhost:3000
# Docker Compose alternative:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/headly
